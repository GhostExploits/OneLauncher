# SpiderClient trusted backend - copy to .env on the SERVER only.
# .env is gitignored. Never ship this file or these values to a desktop client.
#
# The bot token is intentionally not present here. Put the real value in the
# deployment platform's secret manager, or in an untracked .env on the server.
DISCORD_BOT_TOKEN=
# Discord Developer Portal -> General Information -> Public Key.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Comma-separated Discord user IDs allowed to create pairing codes and manage
# all devices. Regular users can still manage devices they personally paired.
SPIDER_OWNER_DISCORD_IDS=

# Optional allowlist. When non-empty, guild commands must originate in one of
# these guild IDs. DMs are denied while the allowlist is active.
SPIDER_ALLOWED_GUILD_IDS=

# Optional private channel for transition alerts (agent online/offline,
# session start/end). The bot must be able to send messages there.
SPIDER_ALERT_CHANNEL_ID=

# Outbound-only agent control plane. Put TLS termination in front of this bind
# address in production; do not expose plain HTTP to the internet.
SPIDER_BIND=127.0.0.1:8787
SPIDER_DATABASE_URL=sqlite://spider_remote.db

# Actions are denied unless both the backend policy and the individual agent
# enable them. Prefer keeping these off until you need them.
SPIDER_ALLOW_LAUNCH=0
SPIDER_ALLOW_STOP=0
# Screenshots capture the selected Minecraft window, not the desktop. The agent
# must also set "allow_screenshot": true in agent.json.
SPIDER_ALLOW_SCREENSHOT=0
# Live coordinates from the SpiderBridge Fabric mod. The agent must also keep
# "allow_bridge": true (the default). The agent's listener is loopback-only and
# read-only; this flag is the remote-side gate. Responses are ephemeral.
SPIDER_ALLOW_COORDINATES=0

# Chat and Minecraft command submission through the SpiderBridge mod. Each one
# needs the matching local switch in agent.json as well; the backend cannot
# change that file. Chat collection is off by default and the mod buffers only
# messages it actually received, in memory, never from latest.log.
SPIDER_ALLOW_CHAT=0
SPIDER_ALLOW_CHAT_SEND=0
SPIDER_ALLOW_MC_COMMAND=0

# Command categories are independent. Commands are validated against an explicit
# grammar, not a name prefix; selectors, raw JSON, unknown commands, and
# chat-shaped commands are refused. State-changing commands also require
# confirm:true in Discord while this is 1. The client can never exceed the
# player's existing server permissions.
SPIDER_MC_ALLOW_READ_ONLY=0
SPIDER_MC_ALLOW_DISRUPTIVE=0
SPIDER_MC_ALLOW_ADMIN=0
SPIDER_REQUIRE_MC_CONFIRM=1

# Days to keep /command-logs lifecycle rows (1-90). Chat message bodies are
# never persisted.
SPIDER_AUDIT_RETENTION_DAYS=7

# Optional separate token for a future website API. This is NOT the bot token.
SPIDER_WEBSITE_API_TOKEN=

# Optional: register commands in one guild for faster propagation during setup.
DISCORD_GUILD_ID=
